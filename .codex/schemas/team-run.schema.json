      "properties": {"id": {"$ref": "#/$defs/text"}, "version": {"const": 1}, "target_id": {"$ref": "#/$defs/text"}, "ref": {"$ref": "#/$defs/text"}, "source_kind": {"enum": ["ROLE", "EXTERNAL"]}, "source": {"$ref": "#/$defs/text"}, "severity": {"enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"]}, "summary": {"$ref": "#/$defs/text"}, "decision": {"enum": ["PENDING", "FIX_NOW", "DEFER", "DISPROVE", "OMIT", "NOT_READY", "USER_ACCEPTED", "DUPLICATE"]}, "status": {"enum": ["OPEN", "RESOLVED"]}, "duplicate_of": {"$ref": "#/$defs/nullable_text"}, "stage": {"$ref": "#/$defs/stage"}, "family": {"$ref": "#/$defs/nullable_text"}, "miss_reason": {"type": ["string", "null"]}, "miss_reason_detail": {"$ref": "#/$defs/nullable_text"}, "evidence": {"$ref": "#/$defs/string_array"}}
