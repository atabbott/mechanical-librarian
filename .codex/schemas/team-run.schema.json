      "properties": {"id": {"$ref": "#/$defs/text"}, "version": {"const": 1}, "target_id": {"$ref": "#/$defs/text"}, "ref": {"$ref": "#/$defs/text"}, "kind": {"enum": ["REPOSITORY", "TREE", "PACKAGE", "MODULE", "WHEEL", "DOCUMENT", "REVIEW_PACKET", "OTHER"]}, "identifier": {"$ref": "#/$defs/text"}, "digest": {"$ref": "#/$defs/sha256"}, "built_at": {"$ref": "#/$defs/timestamp"}, "environment_digest": {"$ref": "#/$defs/sha256"}}
    },
    "event": {
      "type": "object", "additionalProperties": false, "required": ["sequence", "version", "type", "at", "target_id", "ref", "actor", "stage", "from_state", "to_state", "reason", "related_id", "digest", "observation_id", "external_id", "latency_ms", "anchor_kind", "anchor_id", "on_target", "observation_snapshot"],
      "properties": {"sequence": {"type": "integer", "minimum": 1}, "version": {"const": 1}, "type": {"enum": ["RUN_STARTED", "PHASE_ENTERED", "STAGE_STARTED", "STAGE_COMPLETED", "WRITER_STARTED", "WRITER_STOPPED", "ROOT_ESCALATION", "QUALIFICATION_RECORDED", "CONNECTOR_ROUND_STARTED", "CONNECTOR_PICKUP_OBSERVED", "CONNECTOR_PICKUP_REMOVED", "CONNECTOR_PICKUP_UNOBSERVED", "CONNECTOR_TERMINAL_OBSERVED", "MUTATION_RECORDED", "DELIVERY_RECORDED", "PROTOCOL_VARIANCE", "EXECUTION_POLICY_VIOLATION", "FAMILY_EXPANSION_RECORDED", "FAMILY_BOUNDARY_STOP", "PUBLICATION_CHALLENGE_REQUIRED", "MAINTAINER_DECISION_RECORDED", "RUN_ENDED"]}, "at": {"$ref": "#/$defs/timestamp"}, "target_id": {"$ref": "#/$defs/nullable_text"}, "ref": {"$ref": "#/$defs/nullable_text"}, "actor": {"$ref": "#/$defs/nullable_text"}, "stage": {"anyOf": [{"$ref": "#/$defs/stage"}, {"type": "null"}]}, "from_state": {"$ref": "#/$defs/nullable_text"}, "to_state": {"$ref": "#/$defs/nullable_text"}, "reason": {"$ref": "#/$defs/nullable_text"}, "related_id": {"$ref": "#/$defs/nullable_text"}, "digest": {"$ref": "#/$defs/nullable_sha256"}, "observation_id": {"$ref": "#/$defs/nullable_text"}, "external_id": {"$ref": "#/$defs/nullable_text"}, "latency_ms": {"type": ["integer", "null"], "minimum": 0}, "anchor_kind": {"type": ["string", "null"], "enum": [null, "PULL_REQUEST_DESCRIPTION", "REQUEST_COMMENT"]}, "anchor_id": {"$ref": "#/$defs/nullable_text"}, "on_target": {"type": ["boolean", "null"]}, "observation_snapshot": {"$ref": "#/$defs/nullable_text"}}
