      "properties": {"repository_id": {"$ref": "#/$defs/text"}, "base_ref": {"$ref": "#/$defs/text"}, "base_tree": {"$ref": "#/$defs/nullable_sha256"}, "head_ref": {"$ref": "#/$defs/nullable_text"}, "head_tree": {"$ref": "#/$defs/nullable_sha256"}}
    },
    "declaration": {
      "type": "object", "additionalProperties": false, "required": ["role", "kind", "model", "reasoning", "permissions", "capabilities", "forbidden_capabilities", "config_fingerprint"],
      "properties": {"role": {"$ref": "#/$defs/text"}, "kind": {"enum": ["reader", "reviewer", "writer"]}, "model": {"$ref": "#/$defs/text"}, "reasoning": {"enum": ["medium", "high"]}, "permissions": {"enum": [":read-only", ":workspace"]}, "capabilities": {"$ref": "#/$defs/string_array"}, "forbidden_capabilities": {"$ref": "#/$defs/string_array"}, "config_fingerprint": {"$ref": "#/$defs/sha256"}}
