{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mechanical-librarian.invalid/private/team-run.schema.json",
  "title": "Private agent-team delivery record v3",
  "$comment": "Structural schema only. validate_team.py --assert-qualified applies semantic completion rules. v1/v2 remain read-only inputs to the Python validator.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "semantics_version", "run_id", "workflow", "status", "policy_bundle", "continuity", "repository", "team_context", "targets", "artifacts", "bindings", "events", "obligations", "skip_manifest", "criteria", "reviews", "findings", "handoffs", "checks", "external_evidence", "external_gates", "mutations", "connector_rounds", "deliveries", "violations"],
  "properties": {
    "schema_version": {"const": 3},
    "semantics_version": {"const": 1},
    "run_id": {"$ref": "#/$defs/text"},
    "workflow": {"enum": ["clear-defect-backlog", "deliver-focused-change", "deliver-functional-slice", "explore-product-ideas", "maintain-open-prs", "prepare-ready-work"]},
    "status": {"$ref": "#/$defs/status"},
    "policy_bundle": {"$ref": "#/$defs/policy_bundle"},
    "continuity": {"$ref": "#/$defs/continuity"},
    "repository": {"$ref": "#/$defs/repository"},
    "team_context": {"$ref": "#/$defs/team_context"},
    "targets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/target"}},
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "bindings": {"type": "array", "items": {"$ref": "#/$defs/binding"}},
    "events": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/event"}},
    "obligations": {"type": "array", "items": {"$ref": "#/$defs/obligation"}},
    "skip_manifest": {"$ref": "#/$defs/skip_manifest"},
    "criteria": {"type": "array", "items": {"$ref": "#/$defs/criterion"}},
    "reviews": {"type": "array", "items": {"$ref": "#/$defs/review"}},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "handoffs": {"type": "array", "items": {"$ref": "#/$defs/handoff"}},
    "checks": {"type": "array", "items": {"$ref": "#/$defs/check"}},
    "external_evidence": {"type": "array", "items": {"$ref": "#/$defs/external_evidence"}},
    "external_gates": {"type": "array", "items": {"$ref": "#/$defs/external_gate"}},
    "mutations": {"type": "array", "items": {"$ref": "#/$defs/mutation"}},
    "connector_rounds": {"type": "array", "items": {"$ref": "#/$defs/connector_round"}},
    "deliveries": {"type": "array", "items": {"$ref": "#/$defs/delivery"}},
    "violations": {"type": "array", "items": {"$ref": "#/$defs/violation"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "nullable_text": {"type": ["string", "null"], "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "nullable_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "timestamp": {"type": "string", "format": "date-time"},
    "string_array": {"type": "array", "items": {"type": "string"}},
    "status": {"enum": ["INTAKE", "DISCOVERY", "IMPLEMENTATION", "REVIEW", "REMEDIATION", "QUALIFICATION", "DELIVERED", "AWAITING_EXTERNAL", "BLOCKED"]},
    "stage": {"type": "string", "pattern": "^(I|PR)(0|[1-9][0-9]*)$|^C[12]$"},
    "evidence_state": {"enum": ["FRESH", "INHERITED", "NOT_APPLICABLE", "UNAVAILABLE", "STALE"]},
    "policy_bundle": {
      "type": "object", "additionalProperties": false, "required": ["algorithm", "digest", "files"],
      "properties": {"algorithm": {"const": "sha256"}, "digest": {"$ref": "#/$defs/sha256"}, "files": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "digest"], "properties": {"path": {"$ref": "#/$defs/text"}, "digest": {"$ref": "#/$defs/sha256"}}}}
    }},
    "continuity": {
      "type": "object", "additionalProperties": false, "required": ["source_schema_version", "source_record_digest", "upgraded_at", "limitations"],
      "properties": {"source_schema_version": {"enum": [null, 1, 2]}, "source_record_digest": {"$ref": "#/$defs/nullable_sha256"}, "upgraded_at": {"anyOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]}, "limitations": {"$ref": "#/$defs/string_array"}}
    },
    "repository": {
