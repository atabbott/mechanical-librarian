    },
    "capability_evidence": {
      "type": "object", "additionalProperties": false, "required": ["verified", "absent", "provenance"],
      "properties": {"verified": {"$ref": "#/$defs/string_array"}, "absent": {"$ref": "#/$defs/string_array"}, "provenance": {"$ref": "#/$defs/text"}}
    },
    "binding": {
      "type": "object", "additionalProperties": false, "required": ["binding_id", "target_id", "ref", "requested_role", "thread_id", "role", "model", "reasoning", "permissions", "capability_evidence"],
      "properties": {"binding_id": {"$ref": "#/$defs/text"}, "target_id": {"$ref": "#/$defs/nullable_text"}, "ref": {"$ref": "#/$defs/text"}, "requested_role": {"$ref": "#/$defs/text"}, "thread_id": {"$ref": "#/$defs/nullable_text"}, "role": {"$ref": "#/$defs/attestation"}, "model": {"$ref": "#/$defs/attestation"}, "reasoning": {"$ref": "#/$defs/attestation"}, "permissions": {"$ref": "#/$defs/attestation"}, "capability_evidence": {"$ref": "#/$defs/capability_evidence"}}
    },
