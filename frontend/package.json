{
  "name": "mechanical-librarian-browser",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.19.0",
    "npm": "11.17.0"
  },
  "packageManager": "npm@11.17.0",
  "overrides": {
    "js-yaml": "4.3.1"
  },
  "scripts": {
    "generate": "node scripts/generate-dtos.mjs",
    "format": "prettier --write src",
    "pretypecheck": "npm run generate",
    "typecheck": "tsc --noEmit",
    "prelint": "npm run generate",
    "lint": "prettier --check src && eslint .",
    "licenses": "node scripts/check-licenses.mjs",
    "pretest": "npm run generate",
    "test": "vitest run",
    "prebuild": "npm run generate",
    "build": "vite build && node scripts/write-asset-manifest.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.170.27",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.9.0",
    "jsdom": "30.0.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
