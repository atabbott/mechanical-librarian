{
  "name": "mechanical-librarian-browser",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.22.1",
    "npm": "12.2.2"
  },
  "packageManager": "npm@12.2.2",
  "overrides": {
    "js-yaml": "4.3.2",
    "minimatch": "11.0.3"
  },
  "scripts": {
    "generate": "node scripts/generate-dtos.mjs",
    "format": "prettier --write src tests",
    "pretypecheck": "npm run generate",
    "typecheck": "tsc --noEmit",
    "prelint": "npm run generate",
    "lint": "prettier --check src tests && eslint .",
    "licenses": "node scripts/check-licenses.mjs",
    "pretest": "npm run generate",
    "test": "vitest run",
    "prebuild": "npm run generate",
    "build": "vite build && node scripts/write-asset-manifest.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.105.1",
    "@tanstack/react-router": "1.170.46",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
