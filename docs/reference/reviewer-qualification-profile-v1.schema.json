{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "auth_store_path": {
      "description": "Owner-private authentication store. Login and logout may write it; ordinary review mounts only its auth.json file read-only into a disposable provider-state directory.",
      "pattern": "^/",
      "type": "string"
    },
    "codex": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "pattern": "^/",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256",
        "version"
      ],
      "type": "object"
    },
    "job_root_path": {
      "description": "Owner-private root for per-attempt jobs and disposable mutable provider state. Any retained job or trust-failure marker blocks further dispatch pending explicit recovery.",
      "pattern": "^/",
      "type": "string"
    },
    "limits": {
      "additionalProperties": false,
      "properties": {
        "file_bytes": {
          "maximum": 16777216,
          "minimum": 1024,
          "type": "integer"
        },
        "memory_bytes": {
          "maximum": 8589934592,
          "minimum": 134217728,
          "type": "integer"
        },
        "output_bytes": {
          "maximum": 262144,
          "minimum": 1024,
          "type": "integer"
        },
        "processes": {
          "maximum": 64,
          "minimum": 1,
          "type": "integer"
        },
        "timeout_seconds": {
          "maximum": 3600,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "file_bytes",
        "memory_bytes",
        "output_bytes",
        "processes",
        "timeout_seconds"
      ],
      "type": "object"
    },
    "mode": {
      "const": "qualification_only"
    },
    "model": {
      "const": "gpt-5.6-sol"
    },
    "output_version": {
      "const": "shadow-review-result-v1"
    },
    "packet_version": {
      "const": "shadow-review-packet-v5"
    },
    "policy_version": {
      "const": "qualification-only-policy-v1"
    },
    "profile_version": {
      "const": "codex-shadow-profile-v1"
    },
    "prompt_version": {
      "const": "shadow-review-prompt-v2"
    },
    "reasoning": {
      "const": "medium"
    },
    "sandbox": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "pattern": "^/",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "version": {
          "const": "bubblewrap-v1"
        }
      },
      "required": [
        "path",
        "sha256",
        "version"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": "reviewer-qualification-profile-v1"
    }
  },
  "required": [
    "auth_store_path",
    "codex",
    "job_root_path",
    "limits",
    "mode",
    "model",
    "output_version",
    "packet_version",
    "policy_version",
    "profile_version",
    "prompt_version",
    "reasoning",
    "sandbox",
    "schema_version"
  ],
  "type": "object"
}
