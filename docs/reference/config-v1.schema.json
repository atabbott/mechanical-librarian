        "max_backoff_seconds": {
          "default": 300,
          "maximum": 86400,
          "minimum": 1,
          "title": "Max Backoff Seconds",
          "type": "integer"
        },
        "max_elapsed_seconds": {
          "default": 900,
          "maximum": 86400,
          "minimum": 1,
          "title": "Max Elapsed Seconds",
          "type": "integer"
