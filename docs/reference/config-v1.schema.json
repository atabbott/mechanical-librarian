{
  "$defs": {
    "ConnectionInput": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "adapter": {
                "const": "audiobookshelf"
              }
            },
            "required": [
              "adapter"
            ]
          },
          "then": {
            "properties": {
              "enabled_libraries": {
                "items": {
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                }
              }
            }
          }
        }
      ],
      "properties": {
        "adapter": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Adapter",
          "type": "string"
        },
        "capability_overrides": {
          "default": [],
          "items": {
            "enum": [
              "inventory-read",
              "metadata-read",
              "media-file-read",
              "notifications",
              "pagination",
              "concurrency-tokens",
              "cover-read"
            ],
            "type": "string"
          },
          "maxItems": 7,
          "title": "Capability Overrides",
          "type": "array",
          "uniqueItems": true
        },
        "enabled_libraries": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^(?:[a-z][a-z0-9_-]{0,63}|[0-9][0-9a-f]{7}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12})$",
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Enabled Libraries",
          "type": "array",
          "uniqueItems": true
        },
        "endpoint": {
          "maxLength": 256,
          "minLength": 8,
          "pattern": "^https?://",
          "title": "Endpoint",
          "type": "string"
        },
        "id": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "secret_reference": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Secret Reference",
          "type": "string"
        }
      },
      "required": [
        "adapter",
        "endpoint",
        "secret_reference",
        "enabled_libraries"
      ],
      "title": "ConnectionInput",
      "type": "object"
    },
    "EpubOpeningInput": {
      "additionalProperties": false,
      "properties": {
        "child_cpu_seconds": {
          "const": 30,
          "default": 30,
          "title": "Child Cpu Seconds",
          "type": "integer"
        },
        "document_depth": {
          "default": 64,
          "maximum": 128,
          "minimum": 1,
          "title": "Document Depth",
          "type": "integer"
        },
        "excerpt_characters": {
          "const": 280,
          "default": 280,
          "title": "Excerpt Characters",
          "type": "integer"
        },
        "expanded_bytes_per_resource": {
          "default": 1048576,
          "maximum": 4194304,
          "minimum": 1,
          "title": "Expanded Bytes Per Resource",
          "type": "integer"
        },
        "expanded_bytes_per_selection": {
          "default": 5242880,
          "maximum": 33554432,
          "minimum": 1,
          "title": "Expanded Bytes Per Selection",
          "type": "integer"
        },
        "facts": {
          "const": 64,
          "default": 64,
          "title": "Facts",
          "type": "integer"
        },
        "navigation_links": {
          "default": 2048,
          "maximum": 8192,
          "minimum": 1,
          "title": "Navigation Links",
          "type": "integer"
        },
        "nodes_per_resource": {
          "default": 25000,
          "maximum": 100000,
          "minimum": 1,
          "title": "Nodes Per Resource",
          "type": "integer"
        },
        "nodes_per_selection": {
          "default": 100000,
          "maximum": 400000,
          "minimum": 1,
          "title": "Nodes Per Selection",
          "type": "integer"
        },
        "profile": {
          "const": "epub-opening-limits-v1",
          "default": "epub-opening-limits-v1",
          "title": "Profile",
          "type": "string"
        },
        "report_bytes": {
          "const": 524288,
          "default": 524288,
          "title": "Report Bytes",
          "type": "integer"
        },
        "selected_documents": {
          "default": 5,
          "maximum": 8,
          "minimum": 1,
          "title": "Selected Documents",
          "type": "integer"
        },
        "termination_grace_seconds": {
          "const": 2,
          "default": 2,
          "title": "Termination Grace Seconds",
          "type": "integer"
        },
        "text_characters_per_selection": {
          "default": 524288,
          "maximum": 2097152,
          "minimum": 1,
          "title": "Text Characters Per Selection",
          "type": "integer"
        },
        "wall_seconds": {
          "default": 60,
          "maximum": 3600,
          "minimum": 1,
          "title": "Wall Seconds",
          "type": "integer"
        },
        "warnings": {
          "const": 32,
          "default": 32,
          "title": "Warnings",
          "type": "integer"
        }
      },
      "title": "EpubOpeningInput",
      "type": "object"
    },
    "EpubPackageInput": {
      "additionalProperties": false,
      "properties": {
        "archive_entries": {
          "default": 2048,
          "maximum": 8192,
          "minimum": 1,
          "title": "Archive Entries",
          "type": "integer"
        },
        "attributes_per_element": {
          "default": 64,
          "maximum": 256,
          "minimum": 1,
          "title": "Attributes Per Element",
          "type": "integer"
        },
        "compressed_bytes_per_member": {
          "default": 268435456,
          "maximum": 536870912,
          "minimum": 1,
          "title": "Compressed Bytes Per Member",
          "type": "integer"
        },
        "compression_ratio_per_member": {
          "default": 200,
          "maximum": 1000,
          "minimum": 1,
          "title": "Compression Ratio Per Member",
          "type": "integer"
        },
        "container_xml_bytes": {
          "default": 65536,
          "maximum": 1048576,
          "minimum": 1,
          "title": "Container Xml Bytes",
          "type": "integer"
        },
        "decoded_xml_text_characters": {
          "default": 262144,
          "maximum": 4194304,
          "minimum": 1,
          "title": "Decoded Xml Text Characters",
          "type": "integer"
        },
        "expanded_bytes_per_archive": {
          "default": 1073741824,
          "maximum": 2147483648,
          "minimum": 1,
          "title": "Expanded Bytes Per Archive",
          "type": "integer"
        },
        "expanded_bytes_per_member": {
          "default": 268435456,
          "maximum": 536870912,
          "minimum": 1,
          "title": "Expanded Bytes Per Member",
          "type": "integer"
        },
        "guide_references": {
          "default": 256,
          "maximum": 512,
          "minimum": 1,
          "title": "Guide References",
          "type": "integer"
        },
        "manifest_items": {
          "default": 4096,
          "maximum": 8192,
          "minimum": 1,
          "title": "Manifest Items",
          "type": "integer"
        },
        "metadata_nodes": {
          "default": 512,
          "maximum": 2048,
          "minimum": 1,
          "title": "Metadata Nodes",
          "type": "integer"
        },
        "opf_package_bytes": {
          "default": 4194304,
          "maximum": 16777216,
          "minimum": 1,
          "title": "Opf Package Bytes",
          "type": "integer"
        },
        "prefix_mappings": {
          "default": 64,
          "maximum": 256,
          "minimum": 1,
          "title": "Prefix Mappings",
          "type": "integer"
        },
        "profile": {
          "const": "epub-package-limits-v1",
          "default": "epub-package-limits-v1",
          "title": "Profile",
          "type": "string"
        },
        "source_archive_bytes": {
          "default": 268435456,
          "maximum": 536870912,
          "minimum": 1,
          "title": "Source Archive Bytes",
          "type": "integer"
        },
        "spine_items": {
          "default": 4096,
          "maximum": 8192,
          "minimum": 1,
          "title": "Spine Items",
          "type": "integer"
        },
        "xml_attributes_per_document": {
          "default": 100000,
          "maximum": 400000,
          "minimum": 1,
          "title": "Xml Attributes Per Document",
          "type": "integer"
        },
        "xml_depth": {
          "default": 64,
          "maximum": 128,
          "minimum": 1,
          "title": "Xml Depth",
          "type": "integer"
        },
        "xml_nodes_per_document": {
          "default": 50000,
          "maximum": 200000,
          "minimum": 1,
          "title": "Xml Nodes Per Document",
          "type": "integer"
        }
      },
      "title": "EpubPackageInput",
      "type": "object"
    },
    "EvidenceInput": {
      "additionalProperties": false,
      "properties": {
        "enabled_formats": {
          "default": [
            "epub",
            "m4b",
            "mp3"
          ],
          "items": {
            "enum": [
              "epub",
              "m4b",
              "mp3"
            ],
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Enabled Formats",
          "type": "array",
          "uniqueItems": true
        },
        "epub_opening": {
          "$ref": "#/$defs/EpubOpeningInput",
          "default": {
            "child_cpu_seconds": 30,
            "document_depth": 64,
            "excerpt_characters": 280,
            "expanded_bytes_per_resource": 1048576,
            "expanded_bytes_per_selection": 5242880,
            "facts": 64,
            "navigation_links": 2048,
            "nodes_per_resource": 25000,
            "nodes_per_selection": 100000,
            "profile": "epub-opening-limits-v1",
            "report_bytes": 524288,
            "selected_documents": 5,
            "termination_grace_seconds": 2,
            "text_characters_per_selection": 524288,
            "wall_seconds": 60,
            "warnings": 32
          }
        },
        "epub_package": {
          "$ref": "#/$defs/EpubPackageInput",
          "default": {
            "archive_entries": 2048,
            "attributes_per_element": 64,
            "compressed_bytes_per_member": 268435456,
            "compression_ratio_per_member": 200,
            "container_xml_bytes": 65536,
            "decoded_xml_text_characters": 262144,
            "expanded_bytes_per_archive": 1073741824,
            "expanded_bytes_per_member": 268435456,
            "guide_references": 256,
            "manifest_items": 4096,
            "metadata_nodes": 512,
            "opf_package_bytes": 4194304,
            "prefix_mappings": 64,
            "profile": "epub-package-limits-v1",
            "source_archive_bytes": 268435456,
            "spine_items": 4096,
            "xml_attributes_per_document": 100000,
            "xml_depth": 64,
            "xml_nodes_per_document": 50000
          }
        },
        "maximum_document_bytes": {
          "default": 67108864,
          "maximum": 536870912,
          "minimum": 1048576,
          "title": "Maximum Document Bytes",
          "type": "integer"
        },
        "maximum_text_characters": {
          "default": 524288,
          "maximum": 4194304,
          "minimum": 1024,
          "title": "Maximum Text Characters",
          "type": "integer"
        }
      },
      "title": "EvidenceInput",
      "type": "object"
    },
    "HardcoverProviderInput": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": false
              }
            },
            "required": [
              "enabled"
            ]
          },
          "then": {
            "properties": {
              "secret_reference": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": [
              "enabled"
            ]
          },
          "then": {
            "properties": {
              "secret_reference": {
                "type": "string"
              }
            }
          }
        }
      ],
      "properties": {
        "authority_revision": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Authority Revision",
          "type": "integer"
        },
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "secret_reference": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^/(?!.*(?:/\\.{1,2})(?:/|$))(?!.*://)(?!.*[\\u0000-\\u001f\\u007f-\\u009f\\u00ad\\u0600-\\u0605\\u061c\\u06dd\\u070f\\u0890-\\u0891\\u08e2\\u180e\\u200b-\\u200f\\u202a-\\u202e\\u2060-\\u2064\\u2066-\\u206f\\ud800-\\udfff\\ufeff\\ufff9-\\ufffb𑂽𑃍𓐰-𓐿𛲠-𛲣𝅳-𝅺󠀁󠀠-󠁿])(?!.*[\\s\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]$).{0,255}$",
              "type": "string",
              "x-forbiddenUnicodeCategories": [
                "Cc",
                "Cf",
                "Cs"
              ],
              "x-maxUtf8Bytes": 1024
            },
            {
              "type": "null"
            }
          ],
          "title": "Secret Reference"
        }
      },
      "required": [
        "enabled",
        "secret_reference",
        "authority_revision"
      ],
      "title": "HardcoverProviderInput",
      "type": "object"
    },
    "InventoryInput": {
      "additionalProperties": false,
      "properties": {
        "connect_timeout_seconds": {
          "default": 10,
          "maximum": 300,
          "minimum": 1,
          "title": "Connect Timeout Seconds",
          "type": "integer"
        },
        "initial_backoff_seconds": {
          "default": 5,
          "maximum": 3600,
          "minimum": 1,
          "title": "Initial Backoff Seconds",
          "type": "integer"
        },
        "max_attempts": {
          "default": 3,
          "maximum": 16,
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
