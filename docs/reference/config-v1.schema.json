        "max_items": {
          "default": 10000,
          "maximum": 10000,
          "minimum": 2,
          "title": "Max Items",
          "type": "integer"
        },
        "max_pages": {
          "default": 512,
          "maximum": 10000,
          "minimum": 2,
          "title": "Max Pages",
          "type": "integer"
        },
        "max_response_bytes": {
          "default": 67108864,
          "maximum": 67108864,
          "minimum": 1024,
          "title": "Max Response Bytes",
          "type": "integer"
        },
        "page_size": {
          "default": 100,
          "maximum": 500,
          "minimum": 1,
          "title": "Page Size",
          "type": "integer"
        },
        "poll_generation": {
          "default": 0,
          "maximum": 1000000,
          "minimum": 0,
          "title": "Poll Generation",
          "type": "integer"
        },
        "read_timeout_seconds": {
          "default": 30,
          "maximum": 3600,
          "minimum": 1,
          "title": "Read Timeout Seconds",
          "type": "integer"
        },
        "stability_delay_seconds": {
          "default": 0,
          "maximum": 86400,
          "minimum": 0,
          "title": "Stability Delay Seconds",
          "type": "integer"
        },
        "timeout_seconds": {
          "default": 300,
          "maximum": 3600,
          "minimum": 1,
          "title": "Timeout Seconds",
          "type": "integer"
        }
      },
      "title": "InventoryInput",
      "type": "object"
    },
    "MediaMountInput": {
      "additionalProperties": false,
      "properties": {
        "container_path": {
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^/",
