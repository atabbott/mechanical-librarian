{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "ignorePresets": [
    "customManagers:tsconfigNodeVersions"
  ],
  "enabledManagers": [
    "dockerfile",
    "github-actions",
    "npm",
    "pep621",
    "custom.regex"
  ],
  "dependencyDashboard": true,
  "timezone": "Europe/London",
  "schedule": [
    "before 6am on Monday"
  ],
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "prCreation": "immediate",
  "prConcurrentLimit": 5,
  "branchConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "rangeStrategy": "pin",
  "rebaseWhen": "behind-base-branch",
  "ignoreTests": false,
  "platformAutomerge": true,
  "automerge": true,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "labels": [
    "dependencies"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": [
      "before 6am on Monday"
    ]
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "addLabels": [
      "security"
    ],
    "vulnerabilityFixStrategy": "lowest"
  },
  "packageRules": [
    {
      "description": "Preserve the project Python compatibility range",
      "matchManagers": [
        "pep621"
      ],
      "matchDepTypes": [
        "requires-python"
      ],
      "enabled": false
    },
    {
      "description": "Move all Node runtime declarations together",
      "matchDepNames": [
        "node"
      ],
      "groupName": "Node runtime"
    },
    {
      "description": "Move all Python runtime declarations together",
      "matchDepNames": [
        "python"
      ],
      "groupName": "Python runtime"
    },
    {
      "description": "Move all uv resolver declarations together",
      "matchDepNames": [
        "astral-sh/uv",
        "ghcr.io/astral-sh/uv"
      ],
      "groupName": "uv resolver"
    },
    {
      "description": "Move all npm package manager declarations together",
      "matchDepNames": [
        "npm"
      ],
      "groupName": "npm package manager"
    },
    {
      "description": "Require approval for dependency replacements",
      "matchUpdateTypes": [
        "replacement"
      ],
      "automerge": false,
      "dependencyDashboardApproval": true
    }
  ],
  "updateNotScheduled": true,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/public-gate\\.yml$/"
      ],
      "matchStrings": [
        "ghcr\\.io/google/osv-scanner:(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "depNameTemplate": "ghcr.io/google/osv-scanner",
      "datasourceTemplate": "docker"
    }
  ]
}
