# Operating systems and editors
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Secrets and local configuration
.env
.env.*
!.env.example
*.pem
*.key
auth.json
secrets/

# Local agent and private development control directories. Ignoring them keeps
# new local files out of the repository; it does not untrack files already
# committed under them.
.agents/
.claude/
.codex/
.private/

# Runtime state
/data/
/artifacts/
/backups/
/cache/
/reports/
/state/
/.workbench/
*.sqlite
*.sqlite3
*.db

# Mutation-analysis working tree. `mutmut run` copies `src/`, `tests/` and the
# repository files the suite reads into `mutants/` and rewrites the audited
# sources there, so it is generated output rather than a source. It is ignored
# rather than deleted because regenerating it costs a stats collection over the
# whole cohort, and because an untracked directory would otherwise fail the
# clean-tree check in `scripts/qualify_exact_artifact.py` and
# `run_test_tier.py complete`.
/mutants/

# Language and build outputs
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.serena
htmlcov/
.venv/
venv/
node_modules/
dist/
build/
*.egg-info/
coverage/

