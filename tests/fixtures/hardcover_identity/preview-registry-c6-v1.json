    "anti_noop": "compare allowlisted derived typed fields across golden, alternate-valid, single-field mutation, title-only metamorphic, boundary, invalid-extra, and differing-output cases without computing or exporting an input digest; require zero production composition/egress",
    "authority": "no secret lookup, DNS, socket, real provider, production database, target join, proposal, review, or write authority",
    "closed_dsl": "scenario-specific exact JSON Schema; duplicate/unknown/missing keys and out-of-bound values fail",
    "correlation": "non-exported non-persisted non-hashed in-memory monotonic sequencing only when required",
    "database": "c4/c5/c6 require an initially absent path under a new owner-only disposable directory; all other scenarios reject --database",
    "determinism": "canonical JSON plus exactly one LF; alternate valid inputs and metamorphic variants produce independently derived typed outputs",
    "execution": "derive results through the real installed domain/adapter/repository/executor/orchestrator seam available at this increment using only injected structural fakes",
    "expected_output_rule": "canonical example outputs are qualification oracles only and must never be loaded by runtime before emission",
    "input_limit_bytes": 65536,
    "input_source": "contributor-supplied stdin only; --input - is mandatory",
    "privacy_qualification": "capture all v2 channels with hashing, exception, trace/span, metrics, persistence, export, reporting, and audit spies; injected raw/projected/digested forbidden forms must fail",
    "resource_identity_boundary": "immutable public schema/build resource lengths and digests exist only in contributor-independent registry, build, review, and qualification evidence; runtime stdout, stderr, exceptions, logs, trace/span data, metric names/labels/values/exemplars, exports, reports, persistence, and audit records never contain them",
    "runtime_output_privacy": "v2 channel-complete capture: only scenario-allowlisted typed redacted fields; no raw/projected/encoded/hashed/digested/fingerprinted title, private-query, ISBN, provider/resource identity, stable correlation, or substitute in stdout/stderr/exceptions/logs/traces/metrics/persistence/exports/reports/audit",
    "schema8": "c4 runtime regenerates schema 8 through exact migration prefix 1..8 and verifies contributor-independent public registry bindings; contributor stdin contains no schema/build digest and runtime channels emit none"
  },
